{
  "name": "anvilcraft-developer-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "docs:check": "node scripts/check-handbooks.ts",
    "docs:check-render": "node scripts/check-render.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "sass": "1.108.2",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.46",
    "vue-tsc": "3.3.14"
  }
}
